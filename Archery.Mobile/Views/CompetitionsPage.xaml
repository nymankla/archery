<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Archery.Mobile.Views.CompetitionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Archery.Mobile.Core.ViewModels;assembly=Archery.Mobile.Core"
    xmlns:client="clr-namespace:Archery.Client;assembly=Archery.Client"
    xmlns:controls="clr-namespace:Archery.Mobile.Controls"
    x:DataType="vm:CompetitionsViewModel"
    Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*" Padding="12,8" RowSpacing="6">

        <SearchBar Grid.Row="0" Placeholder="Search name or location" Text="{Binding SearchText}" />

        <Label Grid.Row="1" Text="{Binding CountSummary}" FontSize="12" Opacity="0.6" />

        <controls:ErrorBanner
            Grid.Row="2"
            VerticalOptions="Start"
            IsVisible="{Binding HasError}"
            Message="{Binding ErrorMessage}"
            RetryCommand="{Binding LoadCommand}" />

        <RefreshView
            Grid.Row="2"
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            IsVisible="{Binding HasNoError}">

            <CollectionView ItemsSource="{Binding Competitions}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No competitions match the current filter."
                           HorizontalTextAlignment="Center" Margin="0,32" Opacity="0.7" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="client:Competition">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem
                                        Text="Delete"
                                        BackgroundColor="#C0392B"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CompetitionsViewModel}}, Path=DeleteCommand}"
                                        CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Grid Padding="4,12" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CompetitionsViewModel}}, Path=OpenCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                                    <Label Text="{Binding Location}" FontSize="12" Opacity="0.7" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                    <Label Text="{Binding Date, StringFormat='{0:yyyy-MM-dd}'}"
                                           FontSize="12" HorizontalTextAlignment="End" />
                                    <Label Text="{Binding Type}" FontSize="11" Opacity="0.6"
                                           HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
