<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Archery.Mobile.Views.ExternalParticipantsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Archery.Mobile.Core.ViewModels;assembly=Archery.Mobile.Core"
    xmlns:client="clr-namespace:Archery.Client;assembly=Archery.Client"
    xmlns:controls="clr-namespace:Archery.Mobile.Controls"
    x:DataType="vm:ExternalParticipantsViewModel"
    Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="12,8" RowSpacing="6">

        <SearchBar Grid.Row="0" Placeholder="Search name, email or club" Text="{Binding SearchText}" />

        <Picker
            Grid.Row="1"
            Title="All clubs"
            ItemsSource="{Binding Clubs}"
            SelectedItem="{Binding ClubFilter}" />

        <Label Grid.Row="2" Text="{Binding CountSummary}" FontSize="12" Opacity="0.6" />

        <controls:ErrorBanner
            Grid.Row="3"
            VerticalOptions="Start"
            IsVisible="{Binding HasError}"
            Message="{Binding ErrorMessage}"
            RetryCommand="{Binding LoadCommand}" />

        <RefreshView
            Grid.Row="3"
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            IsVisible="{Binding HasNoError}">

            <CollectionView ItemsSource="{Binding Participants}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No guests match the current filter."
                           HorizontalTextAlignment="Center" Margin="0,32" Opacity="0.7" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="client:ExternalParticipant">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem
                                        Text="Delete"
                                        BackgroundColor="#C0392B"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExternalParticipantsViewModel}}, Path=DeleteCommand}"
                                        CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Grid Padding="4,12" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExternalParticipantsViewModel}}, Path=OpenCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding FullName}" FontAttributes="Bold" />
                                    <Label Text="{Binding Email}" FontSize="12" Opacity="0.7" />
                                </VerticalStackLayout>

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding ClubAffiliation}"
                                    FontSize="12"
                                    Opacity="0.7"
                                    VerticalOptions="Center"
                                    HorizontalTextAlignment="End" />
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
