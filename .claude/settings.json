{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$json = $input | ConvertFrom-Json; $fp = $json.tool_input.file_path; if ($fp -match '\\.(cs|razor)$') { dotnet test 'e:\\utv\\test\\UnitTests' --logger 'console;verbosity=minimal' --no-build 2>&1 | Select-Object -Last 8 }",
            "shell": "powershell",
            "timeout": 120,
            "statusMessage": "Running unit tests..."
          }
        ]
      }
    ]
  }
}
