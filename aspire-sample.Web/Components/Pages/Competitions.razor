@page "/competitions"
@rendermode InteractiveServer
@inject ArcheryApiClient Api

<PageTitle>Competitions</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Competitions</h1>
    <button class="btn btn-primary" @onclick="ShowAddForm">Add Competition</button>
</div>

@if (showForm)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">@(editing!.Id == Guid.Empty ? "New Competition" : "Edit Competition")</h5>
            <EditForm Model="editing" OnValidSubmit="Save">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">Name</label>
                        <InputText @bind-Value="editing.Name" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Date</label>
                        <InputDate @bind-Value="editing.Date" @bind-Value:culture="CultureInfo.CurrentCulture" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Location</label>
                        <InputText @bind-Value="editing.Location" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Round Type</label>
                        <InputText @bind-Value="editing.RoundType" class="form-control" placeholder="e.g. WA 18m" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Type</label>
                        <InputSelect @bind-Value="editing.Type" class="form-select">
                            @foreach (var val in Enum.GetValues<CompetitionType>())
                            {
                                <option value="@val">@val</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <InputTextArea @bind-Value="editing.Description" class="form-control" rows="2" />
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-success">Save</button>
                    <button type="button" class="btn btn-secondary ms-2" @onclick="CancelForm">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (competitions == null)
{
    <p><em>Loading...</em></p>
}
else if (competitions.Length == 0)
{
    <p>No competitions registered yet.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Date</th>
                <th>Location</th>
                <th>Round</th>
                <th>Type</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in competitions)
            {
                <tr>
                    <td><a href="/competitions/@c.Id">@c.Name</a></td>
                    <td>@c.Date.ToString("yyyy-MM-dd")</td>
                    <td>@c.Location</td>
                    <td>@c.RoundType</td>
                    <td>@c.Type</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => ShowEditForm(c)">Edit</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(c.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    Competition[]? competitions;
    Competition? editing;
    bool showForm;

    protected override async Task OnInitializedAsync() => await Reload();

    async Task Reload()
    {
        competitions = await Api.GetCompetitionsAsync() ?? [];
    }

    void ShowAddForm()
    {
        editing = new Competition { Date = DateOnly.FromDateTime(DateTime.Today) };
        showForm = true;
    }

    void ShowEditForm(Competition c)
    {
        editing = new Competition
        {
            Id = c.Id, Name = c.Name, Date = c.Date,
            Location = c.Location, RoundType = c.RoundType,
            Type = c.Type, Description = c.Description
        };
        showForm = true;
    }

    void CancelForm()
    {
        showForm = false;
        editing = null;
    }

    async Task Save()
    {
        if (editing!.Id == Guid.Empty)
            await Api.CreateCompetitionAsync(editing);
        else
            await Api.UpdateCompetitionAsync(editing.Id, editing);
        showForm = false;
        await Reload();
    }

    async Task Delete(Guid id)
    {
        await Api.DeleteCompetitionAsync(id);
        await Reload();
    }
}
