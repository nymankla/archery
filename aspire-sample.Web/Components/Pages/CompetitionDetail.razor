@page "/competitions/{Id:guid}"
@rendermode InteractiveServer
@inject ArcheryApiClient Api

<PageTitle>@(competition?.Name ?? "Competition")</PageTitle>

@if (competition == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>@competition.Name</h1>
        <a href="/competitions" class="btn btn-outline-secondary">Back</a>
    </div>

    <dl class="row mb-4">
        <dt class="col-sm-2">Date</dt>
        <dd class="col-sm-10">@competition.Date.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-2">Location</dt>
        <dd class="col-sm-10">@competition.Location</dd>
        <dt class="col-sm-2">Round</dt>
        <dd class="col-sm-10">@competition.RoundType</dd>
        <dt class="col-sm-2">Type</dt>
        <dd class="col-sm-10">@competition.Type</dd>
        @if (!string.IsNullOrEmpty(competition.Description))
        {
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@competition.Description</dd>
        }
    </dl>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Participants</h2>
        <button class="btn btn-primary btn-sm" @onclick="ShowAddParticipantForm">Register Participant</button>
    </div>

    @if (showParticipantForm)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h6 class="card-title">Register Participant</h6>
                <EditForm Model="editingParticipant" OnValidSubmit="SaveParticipant">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="btn-group" role="group">
                                <input type="radio" class="btn-check" id="ppMember" @onchange="() => participantFormType = ParticipantType.Member" checked="@(participantFormType == ParticipantType.Member)" />
                                <label class="btn btn-outline-primary" for="ppMember">Club Member</label>
                                <input type="radio" class="btn-check" id="ppExternal" @onchange="() => participantFormType = ParticipantType.External" checked="@(participantFormType == ParticipantType.External)" />
                                <label class="btn btn-outline-primary" for="ppExternal">External Participant</label>
                            </div>
                        </div>

                        @if (participantFormType == ParticipantType.Member)
                        {
                            <div class="col-md-6">
                                <label class="form-label">Member</label>
                                <InputSelect @bind-Value="editingParticipant!.MemberId" class="form-select">
                                    <option value="">-- Select --</option>
                                    @foreach (var m in members ?? [])
                                    {
                                        <option value="@m.Id">@m.FullName</option>
                                    }
                                </InputSelect>
                            </div>
                        }
                        else
                        {
                            <div class="col-md-6">
                                <label class="form-label">External Participant</label>
                                <InputSelect @bind-Value="editingParticipant!.ExternalParticipantId" class="form-select">
                                    <option value="">-- Select --</option>
                                    @foreach (var p in externalParticipants ?? [])
                                    {
                                        <option value="@p.Id">@p.FullName (@(p.ClubAffiliation ?? "no club"))</option>
                                    }
                                </InputSelect>
                            </div>
                        }

                        <div class="col-md-4">
                            <label class="form-label">Bow Class</label>
                            <InputSelect @bind-Value="editingParticipant!.BowClass" class="form-select">
                                @foreach (var val in Enum.GetValues<BowClass>())
                                {
                                    <option value="@val">@val</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Age Class</label>
                            <InputSelect @bind-Value="editingParticipant!.AgeClass" class="form-select">
                                @foreach (var val in Enum.GetValues<AgeClass>())
                                {
                                    <option value="@val">@val</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Gender</label>
                            <InputSelect @bind-Value="editingParticipant!.Gender" class="form-select">
                                @foreach (var val in Enum.GetValues<Gender>())
                                {
                                    <option value="@val">@val</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(participantFormError))
                    {
                        <div class="alert alert-danger mt-3">@participantFormError</div>
                    }
                    <div class="mt-3">
                        <button type="submit" class="btn btn-success">Register</button>
                        <button type="button" class="btn btn-secondary ms-2" @onclick="CancelParticipantForm">Cancel</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (competitionParticipants == null)
    {
        <p><em>Loading participants...</em></p>
    }
    else if (competitionParticipants.Length == 0)
    {
        <p>No participants registered yet.</p>
    }
    else
    {
        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <select class="form-select" @bind="participantBowClassFilter">
                    <option value="">All bow classes</option>
                    @foreach (var bc in Enum.GetValues<BowClass>())
                    {
                        <option value="@bc">@bc</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="participantTypeFilter">
                    <option value="">All types</option>
                    <option value="member">Club members</option>
                    <option value="external">External</option>
                </select>
            </div>
            @if (!string.IsNullOrEmpty(participantBowClassFilter) || !string.IsNullOrEmpty(participantTypeFilter))
            {
                <div class="col-auto d-flex align-items-center">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ClearParticipantFilters">✕ Clear</button>
                </div>
            }
        </div>

        var visibleParticipants = FilteredParticipants.ToList();
        @if (visibleParticipants.Count == 0)
        {
            <p class="text-muted">No participants match the current filter.</p>
        }
        else
        {
        <table class="table table-sm table-striped mb-4">
            <thead>
                <tr>
                    <th>Participant</th>
                    <th>Bow Class</th>
                    <th>Age Class</th>
                    <th>Gender</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in visibleParticipants)
                {
                    var hasResult = p.MemberId.HasValue
                        ? (results ?? []).Any(r => r.MemberId == p.MemberId)
                        : (results ?? []).Any(r => r.ExternalParticipantId == p.ExternalParticipantId);
                    <tr>
                        <td>@p.ParticipantName</td>
                        <td>@p.BowClass</td>
                        <td>@p.AgeClass</td>
                        <td>@p.Gender</td>
                        <td class="text-end">
                            @if (!hasResult)
                            {
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ShowAddResultFromParticipant(p)">Enter Result</button>
                            }
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveParticipant(p)">Remove</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        }
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Results</h2>
        <button class="btn btn-primary btn-sm" @onclick="ShowAddResultForm">Add Result</button>
    </div>

    @if (showResultForm)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h6 class="card-title">@(editingResult!.Id == Guid.Empty ? "New Result" : "Edit Result")</h6>
                <EditForm Model="editingResult" OnValidSubmit="SaveResult">
                    @if (editingResult!.Id == Guid.Empty)
                    {
                        var available = RegisteredWithoutResult().ToList();
                        @if (available.Count > 0)
                        {
                            <div class="mb-3">
                                <span class="text-muted small">Fill from registered participant: </span>
                                <div class="d-flex flex-wrap gap-2 mt-1">
                                    @foreach (var p in available)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => FillFromParticipant(p)">
                                            @p.ParticipantName
                                        </button>
                                    }
                                </div>
                            </div>
                            <hr class="mt-0 mb-3" />
                        }
                    }
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="btn-group" role="group">
                                <input type="radio" class="btn-check" id="ptMember" @onchange="() => participantType = ParticipantType.Member" checked="@(participantType == ParticipantType.Member)" />
                                <label class="btn btn-outline-primary" for="ptMember">Club Member</label>
                                <input type="radio" class="btn-check" id="ptExternal" @onchange="() => participantType = ParticipantType.External" checked="@(participantType == ParticipantType.External)" />
                                <label class="btn btn-outline-primary" for="ptExternal">External Participant</label>
                            </div>
                        </div>

                        @if (participantType == ParticipantType.Member)
                        {
                            <div class="col-md-6">
                                <label class="form-label">Member</label>
                                <InputSelect @bind-Value="editingResult.MemberId" class="form-select">
                                    <option value="">-- Select --</option>
                                    @foreach (var m in members ?? [])
                                    {
                                        <option value="@m.Id">@m.FullName</option>
                                    }
                                </InputSelect>
                            </div>
                        }
                        else
                        {
                            <div class="col-md-6">
                                <label class="form-label">External Participant</label>
                                <InputSelect @bind-Value="editingResult.ExternalParticipantId" class="form-select">
                                    <option value="">-- Select --</option>
                                    @foreach (var p in externalParticipants ?? [])
                                    {
                                        <option value="@p.Id">@p.FullName (@(p.ClubAffiliation ?? "no club"))</option>
                                    }
                                </InputSelect>
                            </div>
                        }

                        <div class="col-md-3">
                            <label class="form-label">Bow Class</label>
                            <InputSelect @bind-Value="editingResult.BowClass" class="form-select">
                                @foreach (var val in Enum.GetValues<BowClass>())
                                {
                                    <option value="@val">@val</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Age Class</label>
                            <InputSelect @bind-Value="editingResult.AgeClass" class="form-select">
                                @foreach (var val in Enum.GetValues<AgeClass>())
                                {
                                    <option value="@val">@val</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Gender</label>
                            <InputSelect @bind-Value="editingResult.Gender" class="form-select">
                                @foreach (var val in Enum.GetValues<Gender>())
                                {
                                    <option value="@val">@val</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Total Score</label>
                            <InputNumber @bind-Value="editingResult.TotalScore" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">X Count</label>
                            <InputNumber @bind-Value="editingResult.XCount" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Placement</label>
                            <InputNumber @bind-Value="editingResult.Placement" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notes</label>
                            <InputTextArea @bind-Value="editingResult.Notes" class="form-control" rows="2" />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <InputCheckbox @bind-Value="editingResult.IsDisqualified" class="form-check-input" id="isDQ" />
                                <label class="form-check-label" for="isDQ">Disqualified</label>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(formError))
                    {
                        <div class="alert alert-danger mt-3">@formError</div>
                    }
                    <div class="mt-3">
                        <button type="submit" class="btn btn-success">Save</button>
                        <button type="button" class="btn btn-secondary ms-2" @onclick="CancelResultForm">Cancel</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (results == null)
    {
        <p><em>Loading results...</em></p>
    }
    else if (results.Length == 0)
    {
        <p>No results recorded yet.</p>
    }
    else
    {
        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <input type="search" class="form-control" placeholder="Search participant…"
                       @bind="resultSearchText" @bind:event="oninput" />
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="resultBowClassFilter">
                    <option value="">All bow classes</option>
                    @foreach (var bc in Enum.GetValues<BowClass>())
                    {
                        <option value="@bc">@bc</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" @bind="resultGenderFilter">
                    <option value="">All genders</option>
                    @foreach (var g in Enum.GetValues<Gender>())
                    {
                        <option value="@g">@g</option>
                    }
                </select>
            </div>
            @if (!string.IsNullOrEmpty(resultSearchText) || !string.IsNullOrEmpty(resultBowClassFilter) || !string.IsNullOrEmpty(resultGenderFilter))
            {
                <div class="col-auto d-flex align-items-center">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ClearResultFilters">✕ Clear</button>
                </div>
            }
        </div>

        var visibleResults = FilteredResults.ToList();
        @if (visibleResults.Count == 0)
        {
            <p class="text-muted">No results match the current filter.</p>
        }
        else
        {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Participant</th>
                    <th>Bow Class</th>
                    <th>Age Class</th>
                    <th>Gender</th>
                    <th>Score</th>
                    <th>X</th>
                    <th>DQ</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in visibleResults)
                {
                    <tr class="@(r.IsDisqualified ? "table-danger" : "")">
                        <td>@(r.Placement?.ToString() ?? "—")</td>
                        <td>@r.ParticipantName</td>
                        <td>@r.BowClass</td>
                        <td>@r.AgeClass</td>
                        <td>@r.Gender</td>
                        <td>@r.TotalScore</td>
                        <td>@r.XCount</td>
                        <td>@(r.IsDisqualified ? "Yes" : "")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => ShowEditResultForm(r)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteResult(r)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        }
    }
}

<ConfirmDialog Visible="confirmVisible" Message="@confirmMessage" ConfirmLabel="@confirmLabel" OnConfirmed="ExecuteConfirm" OnCancelled="() => confirmVisible = false" />

@code {
    [Parameter] public Guid Id { get; set; }

    bool confirmVisible; string confirmMessage = string.Empty; string confirmLabel = "Delete"; Func<Task>? confirmAction;
    void Confirm(string msg, Func<Task> action, string label = "Delete") { confirmMessage = msg; confirmLabel = label; confirmAction = action; confirmVisible = true; }
    async Task ExecuteConfirm() { confirmVisible = false; if (confirmAction != null) await confirmAction(); }

    enum ParticipantType { Member, External }

    Competition? competition;
    CompetitionParticipant[]? competitionParticipants;
    CompetitionResult[]? results;
    Member[]? members;
    ExternalParticipant[]? externalParticipants;
    CompetitionParticipant? editingParticipant;
    bool showParticipantForm;
    string? participantFormError;
    ParticipantType participantFormType = ParticipantType.Member;
    CompetitionResult? editingResult;
    bool showResultForm;
    string? formError;
    ParticipantType participantType = ParticipantType.Member;

    string participantBowClassFilter = string.Empty;
    string participantTypeFilter = string.Empty;

    IEnumerable<CompetitionParticipant> FilteredParticipants => (competitionParticipants ?? []).Where(p =>
        (string.IsNullOrEmpty(participantBowClassFilter) ||
            (Enum.TryParse<BowClass>(participantBowClassFilter, out var pbc) && p.BowClass == pbc)) &&
        (string.IsNullOrEmpty(participantTypeFilter) ||
            (participantTypeFilter == "member" && p.MemberId.HasValue) ||
            (participantTypeFilter == "external" && p.ExternalParticipantId.HasValue)));

    void ClearParticipantFilters() { participantBowClassFilter = string.Empty; participantTypeFilter = string.Empty; }

    string resultSearchText = string.Empty;
    string resultBowClassFilter = string.Empty;
    string resultGenderFilter = string.Empty;

    IEnumerable<CompetitionResult> FilteredResults => (results ?? []).Where(r =>
        (string.IsNullOrWhiteSpace(resultSearchText) ||
            r.ParticipantName.Contains(resultSearchText, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(resultBowClassFilter) ||
            (Enum.TryParse<BowClass>(resultBowClassFilter, out var rbc) && r.BowClass == rbc)) &&
        (string.IsNullOrEmpty(resultGenderFilter) ||
            (Enum.TryParse<Gender>(resultGenderFilter, out var rg) && r.Gender == rg)));

    void ClearResultFilters() { resultSearchText = string.Empty; resultBowClassFilter = string.Empty; resultGenderFilter = string.Empty; }

    protected override async Task OnInitializedAsync()
    {
        var tasks = new Task[]
        {
            Api.GetCompetitionAsync(Id).ContinueWith(t => competition = t.Result),
            Api.GetMembersAsync().ContinueWith(t => members = t.Result ?? []),
            Api.GetExternalParticipantsAsync().ContinueWith(t => externalParticipants = t.Result ?? [])
        };
        await Task.WhenAll(tasks);
        await Task.WhenAll(ReloadParticipants(), ReloadResults());
    }

    async Task ReloadParticipants()
    {
        competitionParticipants = await Api.GetParticipantsByCompetitionAsync(Id) ?? [];
    }

    async Task ReloadResults()
    {
        results = await Api.GetResultsByCompetitionAsync(Id) ?? [];
    }

    void ShowAddParticipantForm()
    {
        editingParticipant = new CompetitionParticipant { CompetitionId = Id };
        participantFormType = ParticipantType.Member;
        participantFormError = null;
        showParticipantForm = true;
    }

    void CancelParticipantForm()
    {
        showParticipantForm = false;
        editingParticipant = null;
        participantFormError = null;
    }

    async Task SaveParticipant()
    {
        if (participantFormType == ParticipantType.Member)
            editingParticipant!.ExternalParticipantId = null;
        else
            editingParticipant!.MemberId = null;

        if (editingParticipant.MemberId == null && editingParticipant.ExternalParticipantId == null)
        {
            participantFormError = "Please select a participant.";
            return;
        }

        var response = await Api.RegisterParticipantAsync(editingParticipant);
        if (!response.IsSuccessStatusCode)
        {
            participantFormError = await response.Content.ReadAsStringAsync();
            return;
        }

        showParticipantForm = false;
        await ReloadParticipants();
    }

    void RemoveParticipant(CompetitionParticipant p) =>
        Confirm($"Remove {p.ParticipantName} from this competition?", async () =>
        {
            await Api.RemoveParticipantAsync(p.Id);
            await ReloadParticipants();
        }, label: "Remove");

    IEnumerable<CompetitionParticipant> RegisteredWithoutResult() =>
        (competitionParticipants ?? []).Where(p =>
            p.MemberId.HasValue
                ? !(results ?? []).Any(r => r.MemberId == p.MemberId)
                : !(results ?? []).Any(r => r.ExternalParticipantId == p.ExternalParticipantId));

    void FillFromParticipant(CompetitionParticipant p)
    {
        editingResult!.MemberId = p.MemberId;
        editingResult.ExternalParticipantId = p.ExternalParticipantId;
        editingResult.BowClass = p.BowClass;
        editingResult.AgeClass = p.AgeClass;
        editingResult.Gender = p.Gender;
        participantType = p.MemberId.HasValue ? ParticipantType.Member : ParticipantType.External;
    }

    void ShowAddResultFromParticipant(CompetitionParticipant p)
    {
        editingResult = new CompetitionResult { CompetitionId = Id };
        FillFromParticipant(p);
        formError = null;
        showResultForm = true;
    }

    void ShowAddResultForm()
    {
        editingResult = new CompetitionResult { CompetitionId = Id };
        participantType = ParticipantType.Member;
        formError = null;
        showResultForm = true;
    }

    void ShowEditResultForm(CompetitionResult r)
    {
        editingResult = new CompetitionResult
        {
            Id = r.Id, CompetitionId = r.CompetitionId,
            MemberId = r.MemberId, ExternalParticipantId = r.ExternalParticipantId,
            BowClass = r.BowClass, AgeClass = r.AgeClass, Gender = r.Gender,
            TotalScore = r.TotalScore, XCount = r.XCount, Placement = r.Placement,
            IsDisqualified = r.IsDisqualified, Notes = r.Notes
        };
        participantType = r.MemberId.HasValue ? ParticipantType.Member : ParticipantType.External;
        formError = null;
        showResultForm = true;
    }

    void CancelResultForm()
    {
        showResultForm = false;
        editingResult = null;
        formError = null;
    }

    async Task SaveResult()
    {
        if (participantType == ParticipantType.Member)
            editingResult!.ExternalParticipantId = null;
        else
            editingResult!.MemberId = null;

        if (editingResult.MemberId == null && editingResult.ExternalParticipantId == null)
        {
            formError = "Please select a participant.";
            return;
        }

        HttpResponseMessage response;
        if (editingResult.Id == Guid.Empty)
            response = await Api.CreateResultAsync(editingResult);
        else
            response = await Api.UpdateResultAsync(editingResult.Id, editingResult);

        if (!response.IsSuccessStatusCode)
        {
            formError = await response.Content.ReadAsStringAsync();
            return;
        }

        showResultForm = false;
        await ReloadResults();
    }

    void DeleteResult(CompetitionResult r) =>
        Confirm($"Delete result for {r.ParticipantName}?", async () =>
        {
            await Api.DeleteResultAsync(r.Id);
            await ReloadResults();
        });
}
