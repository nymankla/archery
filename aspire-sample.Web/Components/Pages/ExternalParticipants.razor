@page "/external-participants"
@rendermode InteractiveServer
@inject ArcheryApiClient Api

<PageTitle>External Participants</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>External Participants</h1>
    <div>
        <button class="btn btn-primary me-2" @onclick="ShowAddForm">Add Participant</button>
        <button class="btn btn-outline-secondary" @onclick="ToggleImport">Import</button>
    </div>
</div>

@if (showImport)
{
    <ImportPanel Title="Import External Participants"
        OnImport="@((bytes, name) => Api.ImportExternalParticipantsAsync(bytes, name))"
        OnImported="@(async _ => await Reload())"
        OnClose="ToggleImport">
        <ColumnHint>
            Expected columns: <code>FirstName</code>, <code>LastName</code> (required),
            optionally <code>Email</code> (used for merge), <code>Phone</code>, <code>ClubAffiliation</code>.
        </ColumnHint>
    </ImportPanel>
}

@if (showForm)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">@(editing!.Id == Guid.Empty ? "New Participant" : "Edit Participant")</h5>
            <EditForm Model="editing" OnValidSubmit="Save">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">First Name</label>
                        <InputText @bind-Value="editing.FirstName" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Last Name</label>
                        <InputText @bind-Value="editing.LastName" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Phone</label>
                        <InputText @bind-Value="editing.Phone" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Email</label>
                        <InputText @bind-Value="editing.Email" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Club Affiliation</label>
                        <InputText @bind-Value="editing.ClubAffiliation" class="form-control" />
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-success">Save</button>
                    <button type="button" class="btn btn-secondary ms-2" @onclick="CancelForm">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (participants != null)
{
    <div class="row g-2 mb-3">
        <div class="col-md-5">
            <input type="search" class="form-control" placeholder="Search name, email or club…"
                   @bind="searchText" @bind:event="oninput" />
        </div>
        <div class="col-md-4">
            <select class="form-select" @bind="clubFilter">
                <option value="">All clubs</option>
                @foreach (var club in DistinctClubs)
                {
                    <option value="@club">@club</option>
                }
            </select>
        </div>
        <div class="col-md-1 d-flex align-items-center">
            @if (!string.IsNullOrEmpty(searchText) || !string.IsNullOrEmpty(clubFilter))
            {
                <button class="btn btn-outline-secondary btn-sm w-100" @onclick="ClearFilters" title="Clear filters">✕</button>
            }
        </div>
    </div>
}

@if (participants == null)
{
    <p><em>Loading...</em></p>
}
else if (participants.Length == 0)
{
    <p>No external participants registered yet.</p>
}
else
{
    var visible = FilteredParticipants.ToList();
    @if (visible.Count == 0)
    {
        <p class="text-muted">No participants match the current filter. <button class="btn btn-link p-0" @onclick="ClearFilters">Clear filters</button></p>
    }
    else
    {
        <div class="text-muted small mb-2">Showing @visible.Count of @participants.Length participant@(participants.Length == 1 ? "" : "s")</div>
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Club</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in visible)
                {
                    <tr>
                        <td>@p.FullName</td>
                        <td>@(p.Email ?? "—")</td>
                        <td>@(p.Phone ?? "—")</td>
                        <td>@(p.ClubAffiliation ?? "—")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => ShowEditForm(p)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(p)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<ConfirmDialog Visible="confirmVisible" Message="@confirmMessage" OnConfirmed="ExecuteConfirm" OnCancelled="() => confirmVisible = false" />

@code {
    bool confirmVisible; string confirmMessage = string.Empty; Func<Task>? confirmAction;
    void Confirm(string msg, Func<Task> action) { confirmMessage = msg; confirmAction = action; confirmVisible = true; }
    async Task ExecuteConfirm() { confirmVisible = false; if (confirmAction != null) await confirmAction(); }

    ExternalParticipant[]? participants;
    ExternalParticipant? editing;
    bool showForm;
    bool showImport;

    string searchText = string.Empty;
    string clubFilter = string.Empty;

    IEnumerable<ExternalParticipant> FilteredParticipants => (participants ?? []).Where(p =>
        (string.IsNullOrWhiteSpace(searchText) ||
            p.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            (p.Email?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (p.ClubAffiliation?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)) &&
        (string.IsNullOrEmpty(clubFilter) ||
            string.Equals(p.ClubAffiliation, clubFilter, StringComparison.OrdinalIgnoreCase)));

    void ClearFilters() { searchText = string.Empty; clubFilter = string.Empty; }

    IEnumerable<string> DistinctClubs =>
        (participants ?? [])
            .Select(p => p.ClubAffiliation)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Select(c => c!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(c => c);

    protected override async Task OnInitializedAsync() => await Reload();

    async Task Reload()
    {
        participants = await Api.GetExternalParticipantsAsync() ?? [];
    }

    void ShowAddForm()
    {
        editing = new ExternalParticipant();
        showForm = true;
    }

    void ShowEditForm(ExternalParticipant p)
    {
        editing = new ExternalParticipant
        {
            Id = p.Id, FirstName = p.FirstName, LastName = p.LastName,
            Phone = p.Phone, Email = p.Email, ClubAffiliation = p.ClubAffiliation
        };
        showForm = true;
    }

    void CancelForm()
    {
        showForm = false;
        editing = null;
    }

    async Task Save()
    {
        if (editing!.Id == Guid.Empty)
            await Api.CreateExternalParticipantAsync(editing);
        else
            await Api.UpdateExternalParticipantAsync(editing.Id, editing);
        showForm = false;
        await Reload();
    }

    void Delete(ExternalParticipant p) =>
        Confirm($"Delete {p.FullName}?", async () =>
        {
            await Api.DeleteExternalParticipantAsync(p.Id);
            await Reload();
        });

    void ToggleImport()
    {
        showImport = !showImport;
    }
}
