@page "/members"
@rendermode InteractiveServer
@inject ArcheryApiClient Api
@inject IHttpClientFactory HttpFactory
@using System.Text.RegularExpressions

<PageTitle>Members</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Members</h1>
    <div>
        <button class="btn btn-primary me-2" @onclick="ShowAddForm">Add Member</button>
        <button class="btn btn-outline-secondary" @onclick="ToggleImport">Import</button>
    </div>
</div>

@if (showImport)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Import Members</h5>
            <p class="text-muted small">
                Expected columns: <code>FirstName</code>, <code>LastName</code>, <code>DateOfBirth</code> (YYYY-MM-DD),
                optionally <code>Email</code>, <code>Phone</code>, <code>Address</code>, <code>JoinDate</code>,
                <code>IsActive</code> (true/false), <code>PreferredBowClass</code> (Recurve/Compound/Barebow/Traditional).
            </p>

            <div class="mb-3">
                <label class="form-label fw-semibold">Upload file (CSV or .xlsx)</label>
                <InputFile OnChange="OnFileSelected" class="form-control" accept=".csv,.xlsx" />
            </div>

            <div class="d-flex align-items-center my-3">
                <hr class="flex-grow-1" /><span class="mx-3 text-muted">or</span><hr class="flex-grow-1" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Google Sheets URL (shared as "Anyone with the link")</label>
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="https://docs.google.com/spreadsheets/d/..." @bind="googleSheetsUrl" />
                    <button class="btn btn-outline-primary" @onclick="ImportFromGoogleSheets" disabled="@importing">Import Sheet</button>
                </div>
            </div>

            @if (importResult != null)
            {
                <div class="alert @(importResult.Errors.Count == 0 ? "alert-success" : "alert-warning") mt-3">
                    <strong>@importResult.Imported new, @importResult.Updated updated.</strong>
                    @if (importResult.Errors.Count > 0)
                    {
                        <ul class="mb-0 mt-2">
                            @foreach (var err in importResult.Errors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(importError))
            {
                <div class="alert alert-danger mt-3">@importError</div>
            }

            <div class="mt-3">
                <button class="btn btn-secondary" @onclick="ToggleImport">Close</button>
            </div>
        </div>
    </div>
}

@if (showForm)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">@(editing!.Id == Guid.Empty ? "New Member" : "Edit Member")</h5>
            <EditForm Model="editing" OnValidSubmit="Save">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">First Name</label>
                        <InputText @bind-Value="editing.FirstName" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Last Name</label>
                        <InputText @bind-Value="editing.LastName" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Address</label>
                        <InputText @bind-Value="editing.Address" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Phone</label>
                        <InputText @bind-Value="editing.Phone" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <InputText @bind-Value="editing.Email" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Date of Birth</label>
                        <InputDate @bind-Value="editing.DateOfBirth" @bind-Value:culture="CultureInfo.CurrentCulture" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Join Date</label>
                        <InputDate @bind-Value="editing.JoinDate" @bind-Value:culture="CultureInfo.CurrentCulture" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Bow Class</label>
                        <InputSelect @bind-Value="editing.PreferredBowClass" class="form-select">
                            @foreach (var val in Enum.GetValues<BowClass>())
                            {
                                <option value="@val">@val</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <InputCheckbox @bind-Value="editing.IsActive" class="form-check-input" id="isActive" />
                            <label class="form-check-label" for="isActive">Active member</label>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-success">Save</button>
                    <button type="button" class="btn btn-secondary ms-2" @onclick="CancelForm">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (members == null)
{
    <p><em>Loading...</em></p>
}
else if (members.Length == 0)
{
    <p>No members registered yet.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Bow Class</th>
                <th>Join Date</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in members)
            {
                <tr>
                    <td><a href="/members/@m.Id">@m.FullName</a></td>
                    <td>@m.Email</td>
                    <td>@m.Phone</td>
                    <td>@m.PreferredBowClass</td>
                    <td>@m.JoinDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        @if (m.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => ShowEditForm(m)">Edit</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(m)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<ConfirmDialog Visible="confirmVisible" Message="@confirmMessage" OnConfirmed="ExecuteConfirm" OnCancelled="() => confirmVisible = false" />

@code {
    bool confirmVisible; string confirmMessage = string.Empty; Func<Task>? confirmAction;
    void Confirm(string msg, Func<Task> action) { confirmMessage = msg; confirmAction = action; confirmVisible = true; }
    async Task ExecuteConfirm() { confirmVisible = false; if (confirmAction != null) await confirmAction(); }

    Member[]? members;
    Member? editing;
    bool showForm;
    bool showImport;
    bool importing;
    string? googleSheetsUrl;
    ImportResult? importResult;
    string? importError;

    protected override async Task OnInitializedAsync() => await Reload();

    async Task Reload()
    {
        members = await Api.GetMembersAsync() ?? [];
    }

    void ShowAddForm()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        editing = new Member { DateOfBirth = today, JoinDate = today };
        showForm = true;
    }

    void ShowEditForm(Member m)
    {
        editing = new Member
        {
            Id = m.Id, FirstName = m.FirstName, LastName = m.LastName,
            Address = m.Address, Phone = m.Phone, Email = m.Email,
            DateOfBirth = m.DateOfBirth, JoinDate = m.JoinDate,
            IsActive = m.IsActive, PreferredBowClass = m.PreferredBowClass
        };
        showForm = true;
    }

    void CancelForm()
    {
        showForm = false;
        editing = null;
    }

    async Task Save()
    {
        if (editing!.Id == Guid.Empty)
            await Api.CreateMemberAsync(editing);
        else
            await Api.UpdateMemberAsync(editing.Id, editing);
        showForm = false;
        await Reload();
    }

    void Delete(Member m) =>
        Confirm($"Delete member {m.FullName}?", async () =>
        {
            await Api.DeleteMemberAsync(m.Id);
            await Reload();
        });

    void ToggleImport()
    {
        showImport = !showImport;
        importResult = null;
        importError = null;
    }

    async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        importResult = null;
        importError = null;
        importing = true;
        try
        {
            var file = e.File;
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
            importResult = await Api.ImportMembersAsync(ms.ToArray(), file.Name);
            if (importResult != null) await Reload();
            else importError = "Import failed — server returned an error.";
        }
        catch (Exception ex)
        {
            importError = ex.Message;
        }
        finally
        {
            importing = false;
        }
    }

    async Task ImportFromGoogleSheets()
    {
        importResult = null;
        importError = null;
        var exportUrl = BuildGoogleSheetsExportUrl(googleSheetsUrl);
        if (exportUrl == null)
        {
            importError = "Invalid Google Sheets URL. Make sure it's a Google Sheets share link.";
            return;
        }
        importing = true;
        try
        {
            var client = HttpFactory.CreateClient("external");
            var bytes = await client.GetByteArrayAsync(exportUrl);
            importResult = await Api.ImportMembersAsync(bytes, "import.csv");
            if (importResult != null) await Reload();
            else importError = "Import failed — server returned an error.";
        }
        catch (Exception ex)
        {
            importError = $"Failed to fetch sheet: {ex.Message}";
        }
        finally
        {
            importing = false;
        }
    }

    static string? BuildGoogleSheetsExportUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return null;
        var idMatch = Regex.Match(url, @"spreadsheets/d/([^/\?#]+)");
        if (!idMatch.Success) return null;
        var id = idMatch.Groups[1].Value;
        var gidMatch = Regex.Match(url, @"gid=(\d+)");
        var gid = gidMatch.Success ? gidMatch.Groups[1].Value : "0";
        return $"https://docs.google.com/spreadsheets/d/{id}/export?format=csv&gid={gid}";
    }
}
