<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="NymBrokerLocal" value="E:\utv\NymBroker\artifacts" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="NymBrokerLocal">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>