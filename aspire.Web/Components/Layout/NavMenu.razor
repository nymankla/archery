<nav class="top-navbar">
    <a class="brand" href="">Archery Club</a>

    <div class="nav-links">
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-speedometer2" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="members">
                <span class="bi bi-people-fill" aria-hidden="true"></span> Members
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="competitions">
                <span class="bi bi-trophy-fill" aria-hidden="true"></span> Competitions
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="fees">
                <span class="bi bi-cash-coin" aria-hidden="true"></span> Fees
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="training-attendance">
                <span class="bi bi-clipboard-check" aria-hidden="true"></span> Training
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="training-history">
                <span class="bi bi-calendar-check" aria-hidden="true"></span> Training History
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="external-participants">
                <span class="bi bi-person-badge-fill" aria-hidden="true"></span> External Participants
            </NavLink>
        </div>
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="user-section">
                <span class="bi bi-person-circle" aria-hidden="true"></span>
                <span class="username">
                    @(context.User.FindFirst("name")?.Value
