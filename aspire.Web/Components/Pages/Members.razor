@page "/members"
@rendermode InteractiveServer
@inject ArcheryApiClient Api

<PageTitle>Members</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Members</h1>
    <div>
        <button class="btn btn-primary me-2" @onclick="ShowAddForm">Add Member</button>
        <button class="btn btn-outline-secondary" @onclick="ToggleImport">Import</button>
    </div>
</div>

@if (showImport)
{
    <ImportPanel Title="Import Members"
        OnImport="@((bytes, name) => Api.ImportMembersAsync(bytes, name))"
        OnImported="@(async _ => await Reload())"
        OnClose="ToggleImport">
        <ColumnHint>
            Expected columns: <code>FirstName</code>, <code>LastName</code>, <code>DateOfBirth</code> (YYYY-MM-DD),
            optionally <code>Email</code>, <code>Phone</code>, <code>Address</code>, <code>JoinDate</code>,
            <code>IsActive</code> (true/false), <code>PreferredBowClass</code> (Recurve/Compound/Barebow/Traditional).
        </ColumnHint>
    </ImportPanel>
}

@if (showForm)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">@(editing!.Id == Guid.Empty ? "New Member" : "Edit Member")</h5>
            <EditForm Model="editing" OnValidSubmit="Save">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">First Name</label>
                        <InputText @bind-Value="editing.FirstName" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Last Name</label>
                        <InputText @bind-Value="editing.LastName" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Address</label>
                        <InputText @bind-Value="editing.Address" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Phone</label>
                        <InputText @bind-Value="editing.Phone" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <InputText @bind-Value="editing.Email" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Personnummer</label>
                        <InputText @bind-Value="editing.Personnummer" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Date of Birth</label>
                        <InputDate @bind-Value="editing.DateOfBirth" @bind-Value:culture="CultureInfo.CurrentCulture" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Join Date</label>
                        <InputDate @bind-Value="editing.JoinDate" @bind-Value:culture="CultureInfo.CurrentCulture" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Bow Class</label>
                        <InputSelect @bind-Value="editing.PreferredBowClass" class="form-select">
                            @foreach (var val in Enum.GetValues<BowClass>())
                            {
                                <option value="@val">@val</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <InputCheckbox @bind-Value="editing.IsActive" class="form-check-input" id="isActive" />
                            <label class="form-check-label" for="isActive">Active member</label>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-success">Save</button>
                    <button type="button" class="btn btn-secondary ms-2" @onclick="CancelForm">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (members != null)
{
    <div class="row g-2 mb-3">
        <div class="col-md-5">
            <input type="search" class="form-control" placeholder="Search name or email…"
                   @bind="searchText" @bind:event="oninput" />
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="statusFilter">
                <option value="">All statuses</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="bowClassFilter">
                <option value="">All bow classes</option>
                @foreach (var bc in Enum.GetValues<BowClass>())
                {
                    <option value="@bc">@bc</option>
                }
            </select>
        </div>
        <div class="col-md-1 d-flex align-items-center">
            @if (!string.IsNullOrEmpty(searchText) || !string.IsNullOrEmpty(statusFilter) || !string.IsNullOrEmpty(bowClassFilter))
            {
                <button class="btn btn-outline-secondary btn-sm w-100" @onclick="ClearFilters" title="Clear filters">✕</button>
            }
        </div>
    </div>
}

@if (members == null)
{
    <p><em>Loading...</em></p>
}
else if (members.Length == 0)
{
    <p>No members registered yet.</p>
}
else
{
    var visible = sort.Apply(FilteredMembers);
    @if (visible.Count == 0)
    {
        <p class="text-muted">No members match the current filter. <button class="btn btn-link p-0" @onclick="ClearFilters">Clear filters</button></p>
    }
    else
    {
        <div class="text-muted small mb-2">Showing @visible.Count of @members.Length member@(members.Length == 1 ? "" : "s")</div>
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <SortableHeader Column="name" Title="Name" ActiveColumn="sort.Column" Ascending="sort.Ascending" OnSort="OnSort" />
                <SortableHeader Column="email" Title="Email" ActiveColumn="sort.Column" Ascending="sort.Ascending" OnSort="OnSort" />
                <SortableHeader Column="phone" Title="Phone" ActiveColumn="sort.Column" Ascending="sort.Ascending" OnSort="OnSort" />
                <SortableHeader Column="bowclass" Title="Bow Class" ActiveColumn="sort.Column" Ascending="sort.Ascending" OnSort="OnSort" />
                <SortableHeader Column="joindate" Title="Join Date" ActiveColumn="sort.Column" Ascending="sort.Ascending" OnSort="OnSort" />
                <SortableHeader Column="status" Title="Status" ActiveColumn="sort.Column" Ascending="sort.Ascending" OnSort="OnSort" />
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in visible)
            {
                <tr>
                    <td><a href="/members/@m.Id">@m.FullName</a></td>
                    <td>@m.Email</td>
                    <td>@m.Phone</td>
                    <td>@m.PreferredBowClass</td>
                    <td>@m.JoinDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        @if (m.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => ShowEditForm(m)">Edit</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(m)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    }
}

<ConfirmDialog Visible="confirmVisible" Message="@confirmMessage" OnConfirmed="ExecuteConfirm" OnCancelled="() => confirmVisible = false" />

@code {
    bool confirmVisible; string confirmMessage = string.Empty; Func<Task>? confirmAction;
    void Confirm(string msg, Func<Task> action) { confirmMessage = msg; confirmAction = action; confirmVisible = true; }
    async Task ExecuteConfirm() { confirmVisible = false; if (confirmAction != null) await confirmAction(); }

    Member[]? members;
    Member? editing;
    bool showForm;
    bool showImport;

    string searchText = string.Empty;
    string statusFilter = string.Empty;
    string bowClassFilter = string.Empty;

    readonly SortState<Member> sort = new SortState<Member>()
        .Add("name", m => m.FullName)
        .Add("email", m => m.Email)
        .Add("phone", m => m.Phone)
        .Add("bowclass", m => m.PreferredBowClass)
        .Add("joindate", m => m.JoinDate)
        .Add("status", m => m.IsActive)
        .Default("name");

    void OnSort(string column) => sort.Toggle(column);

    IEnumerable<Member> FilteredMembers => (members ?? []).Where(m =>
        (string.IsNullOrWhiteSpace(searchText) ||
            m.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            (m.Email?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)) &&
        (string.IsNullOrEmpty(statusFilter) ||
            (statusFilter == "active" && m.IsActive) ||
            (statusFilter == "inactive" && !m.IsActive)) &&
        (string.IsNullOrEmpty(bowClassFilter) ||
            Enum.TryParse<BowClass>(bowClassFilter, out var bc) && m.PreferredBowClass == bc));

    void ClearFilters()
    {
        searchText = string.Empty;
        statusFilter = string.Empty;
        bowClassFilter = string.Empty;
    }

    protected override async Task OnInitializedAsync() => await Reload();

    async Task Reload()
    {
        members = await Api.GetMembersAsync() ?? [];
    }

    void ShowAddForm()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        editing = new Member { DateOfBirth = today, JoinDate = today };
        showForm = true;
    }

    void ShowEditForm(Member m)
    {
        editing = new Member
        {
            Id = m.Id, FirstName = m.FirstName, LastName = m.LastName,
            Address = m.Address, Phone = m.Phone, Email = m.Email, Personnummer = m.Personnummer,
            DateOfBirth = m.DateOfBirth, JoinDate = m.JoinDate,
            IsActive = m.IsActive, PreferredBowClass = m.PreferredBowClass
        };
        showForm = true;
    }

    void CancelForm()
    {
        showForm = false;
        editing = null;
    }

    async Task Save()
    {
        if (editing!.Id == Guid.Empty)
            await Api.CreateMemberAsync(editing);
        else
            await Api.UpdateMemberAsync(editing.Id, editing);
        showForm = false;
        await Reload();
    }

    void Delete(Member m) =>
        Confirm($"Delete member {m.FullName}?", async () =>
        {
            await Api.DeleteMemberAsync(m.Id);
            await Reload();
        });

    void ToggleImport()
    {
        showImport = !showImport;
    }
}
