@page "/training-history"
@rendermode InteractiveServer
@inject ArcheryApiClient Api
@inject FileDownloader FileDownloader

<PageTitle>Training History</PageTitle>

<h1>Training History</h1>

<div class="card mb-4">
	<div class="card-body">
		<div class="row g-3 align-items-end">
			<div class="col-md-6">
				<label class="form-label">Select Training Date</label>
				@if (trainingDates == null)
				{
					<p class="text-muted"><em>Loading available dates...</em></p>
				}
				else if (trainingDates.Length == 0)
				{
					<p class="text-muted">No training sessions recorded yet.</p>
				}
				else
				{
					<select class="form-select" @bind="selectedDate" @bind:after="OnDateSelected">
						<option value="">-- Select a date --</option>
						@foreach (var date in trainingDates)
						{
							<option value="@date">@date.ToString("yyyy-MM-dd")</option>
						}
					</select>
				}
			</div>
		</div>
	</div>
</div>

@if (selectedDate.HasValue && sessionDetail != null)
{
	<div class="card">
		<div class="card-header d-flex justify-content-between align-items-center">
			<strong>Attendance for @selectedDate.Value.ToString("yyyy-MM-dd")</strong>
			@if (sessionDetail.Attendees.Count > 0)
			{
				<div class="btn-group btn-group-sm">
					<button class="btn btn-outline-secondary" disabled="@exporting" @onclick='() => ExportAsync("csv")'>Export CSV</button>
					<button class="btn btn-outline-secondary" disabled="@exporting" @onclick='() => ExportAsync("xlsx")'>Export Excel</button>
				</div>
			}
		</div>
		<div class="card-body">
			@if (!string.IsNullOrWhiteSpace(sessionDetail.Notes))
			{
				<div class="alert alert-info">
					<strong>Notes:</strong> @sessionDetail.Notes
				</div>
			}

			@if (sessionDetail.Attendees.Count == 0)
			{
				<p class="text-muted">No attendees recorded for this date.</p>
			}
			else
			{
				var memberAttendees = sessionDetail.Attendees.Where(a => a.MemberId.HasValue).ToList();
				var externalAttendees = sessionDetail.Attendees.Where(a => a.ExternalParticipantId.HasValue).ToList();

				<div class="row">
					@if (memberAttendees.Count > 0)
					{
						<div class="col-md-6">
							<h5>Club Members (@memberAttendees.Count)</h5>
							<table class="table table-sm">
								<thead>
									<tr>
										<th>First Name</th>
										<th>Last Name</th>
										<th>Personnummer</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var attendee in memberAttendees.OrderBy(a => a.MemberLastName).ThenBy(a => a.MemberFirstName))
									{
										<tr>
											<td>@attendee.MemberFirstName</td>
											<td>@attendee.MemberLastName</td>
											<td>@(attendee.MemberPersonnummer ?? "—")</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}

					@if (externalAttendees.Count > 0)
					{
						<div class="col-md-6">
							<h5>External Participants (@externalAttendees.Count)</h5>
							<table class="table table-sm">
								<thead>
									<tr>
										<th>First Name</th>
										<th>Last Name</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var attendee in externalAttendees.OrderBy(a => a.ExternalParticipantLastName).ThenBy(a => a.ExternalParticipantFirstName))
									{
										<tr>
											<td>@attendee.ExternalParticipantFirstName</td>
											<td>@attendee.ExternalParticipantLastName</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>

				<div class="mt-3">
					<strong>Total participants:</strong> @sessionDetail.Attendees.Count
				</div>
			}
		</div>
	</div>
}
else if (selectedDate.HasValue && sessionDetail == null)
{
	<p class="text-muted"><em>Loading attendance data...</em></p>
}

@code {
	DateOnly[]? trainingDates;
	DateOnly? selectedDate;
	TrainingSessionDetail? sessionDetail;
	bool exporting;

	protected override async Task OnInitializedAsync()
	{
		trainingDates = await Api.GetTrainingDatesAsync();
	}

	async Task OnDateSelected()
	{
		sessionDetail = null;
		if (selectedDate.HasValue)
		{
			sessionDetail = await Api.GetTrainingAttendanceByDateAsync(selectedDate.Value);
		}
	}

	async Task ExportAsync(string format)
	{
		if (!selectedDate.HasValue) return;

		exporting = true;
		try
		{
			var file = await Api.ExportTrainingAttendanceAsync(selectedDate.Value, format);
			if (file != null)
			{
				await FileDownloader.SaveAsync(file);
			}
		}
		finally
		{
			exporting = false;
		}
	}
}
