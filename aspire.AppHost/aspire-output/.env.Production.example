# Template for .env.Production, which `aspire publish` / `aspire deploy` generates next to
# docker-compose.yaml. The real file holds secrets and is git-ignored: copy this to
# .env.Production and fill in the passwords, or let `aspire deploy` write it.

# Container image name for apiservice
APISERVICE_IMAGE=apiservice:aspire-deploy-20260718165920

# Default container port for apiservice
APISERVICE_PORT=8080

# Bind mount source for keycloak:/opt/keycloak/data/import
KEYCLOAK_BINDMOUNT_0=E:\utv\archery\aspire.AppHost\keycloak

# Container image name for migrations
MIGRATIONS_IMAGE=migrations:aspire-deploy-20260718165920

# Parameter keycloak-password
KEYCLOAK_PASSWORD=

# Parameter postgres-password
POSTGRES_PASSWORD=

# Container image name for webfrontend
WEBFRONTEND_IMAGE=webfrontend:aspire-deploy-20260718165920

# Default container port for webfrontend
WEBFRONTEND_PORT=8080

